# Bittensor v11 wallet variables. Leave secrets in your local .env only.
BT_NETWORK=test
TL_NETUID=
BT_WALLET=
BT_WALLET_HOTKEY=
BT_WALLET_PATH=
BT_WALLET_PASSWORD=
BT_WALLET_PASSWORD_FILE=

# Local live TED desk. Bind to loopback for local use.
TL_HOST=127.0.0.1
TL_PORT=8787

# Miner settings. For public testnet service set a reachable host/port and serve-axon.
TL_MINER_HOST=0.0.0.0
TL_MINER_PORT=8091

# Weight submission needs both this opt-in and validator `--submit`.
TL_ENABLE_WEIGHT_SUBMISSION=false
